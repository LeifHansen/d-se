{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "seed": "node ./src/scripts/seed-dose.mjs",
    "test": "tsx --tsconfig tsconfig.json tests/purchase-tracking.test.ts",
    "test:vitest": "vitest run",
    "typecheck": "tsc -b ../../lib/db ../../lib/api-zod && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@clerk/express": "^2.1.7",
    "@easypost/api": "^8.8.0",
    "@google-cloud/storage": "^7.19.0",
    "@opentelemetry/api": "^1.9.1",
    "@sentry/node": "^10.51.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2",
    "drizzle-orm": "catalog:",
    "express": "^5",
    "google-auth-library": "^10.6.2",
    "http-proxy-middleware": "^3.0.5",
    "nanoid": "^5.1.9",
    "pdf-lib": "^1.17.1",
    "pino": "^9",
    "pino-http": "^10",
    "resend": "^4.0.0",
    "sharp": "^0.34.5",
    "stripe": "^20.0.0",
    "stripe-replit-sync": "1.0.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.4.5",
    "drizzle-kit": "^0.31.9",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/supertest": "^7.2.0",
    "esbuild": "^0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13",
    "supertest": "^7.2.2",
    "thread-stream": "3.1.0",
    "tsx": "^4.21.0",
    "vitest": "^4.1.6"
  }
}
